; Bytesrw has no Melange packaging, and its Bytes.Slice interface mentions Bigarray, which Melange
; lacks. This rebuilds the installed Bytesrw sources, unmodified (ISC license header included),
; against melange-bigarray's Bigarray, so the Melange tests use the same Bytesrw source and version
; as the native ones. It is test infrastructure and is never installed. See docs/design.md.

(rule
 (copy %{lib:bytesrw:bytesrw.ml} bytesrw.ml))

(rule
 (copy %{lib:bytesrw:bytesrw.mli} bytesrw.mli))

(rule
 (copy %{lib:bytesrw:bytesrw_fmt.ml} bytesrw_fmt.ml))

(rule
 (copy %{lib:bytesrw:bytesrw_fmt.mli} bytesrw_fmt.mli))

(library
 (name bytesrw_melange)
 (wrapped false)
 (modes melange)
 (flags
  (:standard -w -a))
 (libraries melange-bigarray.compat)
 (enabled_if
  (= %{env:UNLZ4_MELANGE=false} true)))
