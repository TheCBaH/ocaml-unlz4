(library
 (name unlz4_test_support)
 (libraries unlz4)
 (enabled_if
  (<> %{env:UNLZ4_MELANGE=false} true)))

(rule
 (target corpus_data.ml)
 (enabled_if
  (<> %{env:UNLZ4_MELANGE=false} true))
 (deps %{project_root}/test/reference/corpus)
 (action
  (with-stdout-to
   %{target}
   (run %{exe:../../tools/embed.exe} %{project_root}/test/reference/corpus))))
